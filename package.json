{
  "name": "pearl-language-support",
  "displayName": "PEARL Language Support",
  "description": "VS Code Extension mit Language Server für die Sprache PEARL",
  "version": "0.2.12",
  "publisher": "none",
  "author": {
    "name": "Jan Bartels"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jan.bartels/pearl-language-support.git"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/client/extension.js",
  "activationEvents": [
    "onLanguage:pearl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pearl",
        "aliases": [
          "PEARL",
          "pearl"
        ],
        "extensions": [
          ".p",
          ".P"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pearl",
        "scopeName": "source.pearl",
        "path": "./syntaxes/pearl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "PEARL",
      "type": "object",
      "properties": {
        "pearl.maxNumberOfProblems": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Maximum number of diagnostics per PEARL file."
        },
        "pearl.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace level for the PEARL language server."
        },
        "pearl.macros": {
          "type": "object",
          "scope": "resource",
          "markdownDescription": "C-style preprocessor macros für den externen Präprozessor.\n\nSchlüssel = Makroname, Wert = optionaler Ersatztext.\nLeerer Wert bedeutet: Makro nur definiert (`#define NAME`).",
          "default": {},
          "additionalProperties": {
            "type": "string"
          }
        },
        "pearl.workingDirMode": {
          "scope": "window",
          "type": "string",
          "enum": [
            "workspace",
            "file"
          ],
          "default": "file",
          "description": "Workingdirectory im Workspace-Root oder im Verzeichnis der Datei (für #include)"
        },
        "pearl.warnOnCharTruncation": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Warnung ausgeben, wenn bei der Zuweisung oder Übergabe eines CHAR-Wertes Zeichen abgeschnitten werden können."
        }
      }
    },
    "configurationDefaults": {
      "[pearl]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "namespace:pearl": {
            "foreground": "#D6C1F0"
          },
          "type:pearl": {
            "foreground": "#C5A3F5"
          },
          "variable:pearl": {
            "foreground": "#83C7F3"
          },
          "variable.readonly:pearl": {
            "foreground": "#B7DE8A",
            "italic": true
          },
          "parameter:pearl": {
            "foreground": "#71D8C6"
          },
          "parameter.readonly:pearl": {
            "foreground": "#B7DE8A",
            "italic": true
          },
          "property:pearl": {
            "foreground": "#F5A59C"
          },
          "function:pearl": {
            "foreground": "#F2D187"
          },
          "class:pearl": {
            "foreground": "#F29CD4"
          },
          "label:pearl": {
            "foreground": "#92DBD5"
          },
          "macro:pearl": {
            "foreground": "#FFB96B"
          },
          "operator:pearl": {
            "foreground": "#E6D6AA"
          },
          "*.declaration:pearl": {
            "bold": true
          }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "keyword.operator.assign.pearl",
              "keyword.operator.comparator.pearl",
              "keyword.operator.arithmetic.pearl",
              "keyword.operator.logical.pearl",
              "keyword.operator.comparatorref.pearl",
              "keyword.operator.other.pearl",
              "keyword.operator.fixed.pearl",
              "keyword.operator.conversion.pearl"
            ],
            "settings": {
              "foreground": "#E6D6AA"
            }
          },
          {
            "scope": [
              "keyword.control.directive.pearl"
            ],
            "settings": {
              "foreground": "#C5A3F5"
            }
          },
          {
            "scope": [
              "constant.numeric.bitstring.pearl",
              "constant.numeric.hex.pearl",
              "constant.character.escape.pearl"
            ],
            "settings": {
              "foreground": "#98D6B6"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "clean": "rm -rf dist",
    "test": "echo \"no tests\"",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "npm run typecheck && npm run build && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.109.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
