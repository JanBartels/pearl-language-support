{
  "name": "pearl-language-support",
  "displayName": "PEARL Language Support",
  "description": "VS Code Extension mit Language Server für die Sprache PEARL",
  "version": "0.3.5",
  "publisher": "none",
  "author": {
    "name": "Jan Bartels"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jan.bartels/pearl-language-support.git"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/client/extension.js",
  "activationEvents": [
    "onLanguage:pearl",
    "workspaceContains:**/*.P",
    "workspaceContains:**/*.p"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pearl",
        "aliases": [
          "PEARL",
          "pearl"
        ],
        "extensions": [
          ".p",
          ".P"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pearl",
        "scopeName": "source.pearl",
        "path": "./syntaxes/pearl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "PEARL",
      "type": "object",
      "properties": {
        "pearl.analysis.workerCount": {
          "scope": "window",
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 0,
          "description": "Anzahl paralleler Analyse-Worker (0 = lokale Analyse wie bisher; 1 bis 16 = Worker-Threads). Eine Aenderung startet den PEARL Language Server neu."
        },
        "pearl.maxNumberOfProblems": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Maximum number of diagnostics per PEARL file."
        },
        "pearl.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace level for the PEARL language server."
        },
        "pearl.macros": {
          "type": "object",
          "scope": "resource",
          "markdownDescription": "C-style preprocessor macros für den externen Präprozessor.\n\nSchlüssel = Makroname, Wert = optionaler Ersatztext.\nLeerer Wert bedeutet: Makro nur definiert (`#define NAME`).",
          "default": {},
          "additionalProperties": {
            "type": "string"
          }
        },
        "pearl.warnOnCharTruncation": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Warnung ausgeben, wenn bei der Zuweisung oder Übergabe eines CHAR-Wertes Zeichen abgeschnitten werden können."
        },
        "pearl.translationUnits.discoveryDepth": {
          "scope": "resource",
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Maximale Verzeichnistiefe für die automatische Suche nach PEARL-Übersetzungseinheiten (.P): 0 = nur Workspace-Ordner, 1 = eine Unterverzeichnisebene usw. Direkt geöffnete Dateien und #include sind davon unabhängig."
        }
      }
    },
    "configurationDefaults": {
      "[pearl]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "namespace:pearl": {
            "foreground": "#4EC9B0"
          },
          "type:pearl": {
            "foreground": "#4EC9B0"
          },
          "struct:pearl": {
            "foreground": "#4EC9B0"
          },
          "variable:pearl": {
            "foreground": "#9CDCFE"
          },
          "parameter:pearl": {
            "foreground": "#9CDCFE"
          },
          "property:pearl": {
            "foreground": "#9CDCFE"
          },
          "function:pearl": {
            "foreground": "#DCDCAA"
          },
          "class:pearl": {
            "foreground": "#DCDCAA"
          },
          "macro:pearl": {
            "foreground": "#C586C0"
          },
          "label:pearl": {
            "foreground": "#D4D4D4"
          },
          "operator:pearl": {
            "foreground": "#D4D4D4"
          },
          "*.readonly:pearl": {
            "italic": true
          },
          "variable.readonly:pearl": {
            "foreground": "#9CDCFE",
            "italic": true
          },
          "parameter.readonly:pearl": {
            "foreground": "#9CDCFE",
            "italic": true
          },
          "property.readonly:pearl": {
            "foreground": "#9CDCFE",
            "italic": true
          }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "keyword.declaration.pearl",
              "keyword.control.pearl",
              "keyword.other.pearl",
              "keyword.other.call.pearl",
              "keyword.other.goto.pearl",
              "keyword.other.semaop.pearl",
              "keyword.other.io.pearl",
              "keyword.other.realtime.pearl",
              "storage.type.pearl",
              "constant.language.pearl"
            ],
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "scope": [
              "keyword.operator.assign.pearl",
              "keyword.operator.comparator.pearl",
              "keyword.operator.arithmetic.pearl",
              "keyword.operator.logical.pearl",
              "keyword.operator.comparatorref.pearl",
              "keyword.operator.other.pearl",
              "keyword.operator.fixed.pearl",
              "keyword.operator.conversion.pearl"
            ],
            "settings": {
              "foreground": "#D4D4D4"
            }
          },
          {
            "scope": [
              "keyword.control.directive.pearl"
            ],
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": [
              "constant.numeric.bitstring.pearl",
              "constant.numeric.hex.pearl",
              "constant.numeric.clock.pearl",
              "constant.numeric.duration.pearl",
              "constant.numeric.float.pearl",
              "constant.numeric.integer.pearl"
            ],
            "settings": {
              "foreground": "#B5CEA8"
            }
          },
          {
            "scope": [
              "string.quoted.single.pearl",
              "string.quoted.double.pearl"
            ],
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "scope": [
              "constant.character.escape.pearl"
            ],
            "settings": {
              "foreground": "#D7BA7D"
            }
          },
          {
            "scope": [
              "comment.line.exclamation.pearl",
              "comment.block.pearl"
            ],
            "settings": {
              "foreground": "#6A9955"
            }
          }
        ]
      }
    },
    "commands": [
      {
        "command": "pearl.pickIncludeContext",
        "title": "Include-Kontext auswählen",
        "category": "PEARL"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "clean": "rm -rf dist",
    "test": "echo \"no tests\"",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "npm run typecheck && npm run build && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.109.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
