Unit13Proc01: PROC;
    DCL Acc FIXED INIT(0);
    DCL Index FIXED;
    DCL Limit FIXED INIT(9);
    Acc := Acc + 1;
    IF Acc > Limit THEN
        Acc := Acc - 1;
    ELSE
        Acc := Acc + 2;
    FIN;
    Acc := Acc + 2;
    Acc := Acc + 3;
    Acc := Acc + 4;
    IF Acc > Limit THEN
        Acc := Acc - 1;
    ELSE
        Acc := Acc + 2;
    FIN;
    Acc := Acc + 5;
    Acc := Acc + 1;
    Acc := Acc + 2;
    IF Acc > Limit THEN
        Acc := Acc - 1;
    ELSE
        Acc := Acc + 2;
    FIN;
    Acc := Acc + 3;
    Acc := Acc + 4;
    Acc := Acc + 5;
    IF Acc > Limit THEN
        Acc := Acc - 1;
    ELSE
        Acc := Acc + 2;
    FIN;
    Acc := Acc + 1;
    Acc := Acc + 2;
    FOR Index FROM 1 TO 5 REPEAT
        Acc := Acc + Index;
    END;
END;

