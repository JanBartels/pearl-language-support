    ELSE
        Acc := Acc + 2;
    FIN;
    Acc := Acc + 2;
    Acc := Acc + 3;
    Acc := Acc + 4;
    IF Acc > Limit THEN
        Acc := Acc - 1;
    ELSE
        Acc := Acc + 2;
    FIN;
    Acc := Acc + 5;
