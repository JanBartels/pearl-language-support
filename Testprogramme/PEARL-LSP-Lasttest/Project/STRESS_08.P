Unit08Task: TASK PRIO 9;
    DCL Counter FIXED INIT(0);
    DCL Step FIXED INIT(1);
    FOR Counter FROM 1 TO 10 REPEAT
        Step := Step + Counter;
        IF Step > 100 THEN
            Step := Step - 100;
        FIN;
    END;
END;

