MODULE CondRepeatedOut;
PROBLEM;

DCL Flag BIT(1);
DCL Selection FIXED;

T: TASK;
    CASE Selection
        ALT
            BEGIN
            END;
        OUT
            BEGIN
                DCL FirstOut FIXED;
            END;
        OUT
            BEGIN
                DCL SecondOut FIXED;
            END;
    FIN;
    BEGIN
        DCL Survives FIXED;
    END;
END;

MODEND;
