!MODE=NOLSTOP;
!MODE=CLOCK50;
MODE=HUHU;

MODULE huhu;
SYSTEM;
PROBLEM;

/*+M*/

TYPE SNode STRUCT[
    Value FIXED,
    Next REF SNode
];

SPC SScalar FIXED GLOBAL;
SPC SScalarInit FIXED INIT(4) GLOBAL;
SPC SVector() FIXED;
SPC SMatrix(,) FLOAT(55) GLOBAL;
SPC SNodes() SNode GLOBAL;
SPC SHandles(,) REF SNode GLOBAL;

SPC SSemaphores() SEMA GLOBAL;
SPC SBolts(,) BOLT GLOBAL;

DCL SVector(4) FIXED;

SPC ForwardScalar FIXED;
SPC ForwardVector() FIXED;

SPC ExternalScalar FIXED GLOBAL;
SPC ExternalVector() FIXED GLOBAL;

DCL ForwardScalar FIXED;
DCL ForwardVector(10) FIXED;

SPC ForwardRangError(,) FIXED;
DCL ForwardRangError(10) FIXED;

SPC ForwardTypeError() FLOAT;
DCL ForwardTypeError(10) FIXED;

DCL GA FIXED GLOBAL;
DCL GB FLOAT GLOBAL(OtherModule);
DCL GC INV FIXED GLOBAL INIT(10);

DCL SP SEMA GLOBAL PRESET(1);
DCL BOLT1 BOLT GLOBAL;

TYPE Person STRUCT[
    Age FIXED
];

DCL Maier Person;
DCL Arbeitszeiger REF Person INIT(Maier);

DCL x FIXED;
DCL (a, b) FLOAT;
!DCL matrix(1:10, 0:20) FLOAT;
DCL person Person;
DCL personRef REF Person;
DCL constant INV FIXED;

DCL x FLOAT;

DCL N INV FIXED INIT(10);
DCL M INV FIXED INIT(N * 2);
DCL O INV FIXED INIT(N * 2 - 1);
DCL matrix(1:M, 0:N-1) FLOAT;

DCL S SEMA;
DCL B BOLT;

DCL Semaphores(1:10) SEMA;
DCL Bolts(0:3) BOLT;

DCL S0 SEMA PRESET(3);
DCL (S1, S2) SEMA PRESET(3, 5);

DCL SN INV FIXED INIT(10);
DCL (SA, SB) SEMA PRESET(SN, SN * 2);

DCL SC(1:2) SEMA PRESET(1, 2);
DCL SD(1:3) SEMA PRESET(1, 2);

DCL IA FIXED INIT(10);
DCL IB INV FIXED INIT(IA * 2);     ! Fehler

DCL IA1 INV FIXED INIT(10);
DCL IB1 FIXED INIT(IA1 * 2);          ! OK, Ausdruck = 20

DCL IC INV FIXED INIT(10);
DCL ID INV FIXED INIT(IC * 2);     ! OK, D = 20

DCL IE INV FIXED INIT(Unknown);   ! unbekannter Bezeichner

DCL (I_F, IG) INV FIXED INIT(1, 2);   ! OK
DCL (IH, II) INV FIXED INIT(1);      ! Fehler
DCL IJ FIXED INIT(1.5);             ! Fehler

DCL FA(3) FIXED INIT(1, 2, 3);    ! OK
DCL FB(3) FIXED INIT(1);          ! OK -> 1, 1, 1
DCL FC(3) FIXED INIT(1, 2);       ! OK -> 1, 2, 2

DCL FN INV FIXED INIT(10);
DCL FD(3) FIXED INIT(FN, FN * 2);   ! OK

DCL FE(3) FIXED INIT(1, 2, 3, 4);

DCL C0 CLOCK INIT(11:30:00);
DCL C1 CLOCK INIT(15:45:3.5);
DCL C2 CLOCK INIT(25:00:00);

DCL CK INV CLOCK INIT(12:00:00);
DCL C3 CLOCK INIT(CK);

DCL D0 DURATION INIT(5 MIN 30 SEC);
DCL D1 DURATION INIT(.05 SEC);
DCL D2 DURATION INIT(5 HRS 10 SEC);

DCL DK INV DURATION INIT(2 MIN);
DCL D3 DURATION INIT(DK);

DCL BadMinute CLOCK INIT(12:60:00);
DCL BadSecond CLOCK INIT(12:00:60);

DCL FineClock CLOCK INIT(12:00:00.00005);
DCL FineDuration DURATION INIT(0.00005 SEC);

DCL DN0 DURATION INIT(-5 SEC);
DCL DN1 DURATION INIT(-5 MIN 30 SEC);
DCL DN2 DURATION INIT(-.05 SEC);
DCL DN3 DURATION INIT(+2 HRS 5 SEC);

DCL DNK INV DURATION INIT(-10 SEC);
DCL DN4 DURATION INIT(DK);

DCL FN0 FIXED INIT(-5);
DCL FN1 FIXED INIT(-5 + 2);
DCL FN2 FIXED INIT(-(5 + 2));
DCL FNI2 INV FIXED INIT(-(5 + 2));

DCL XN0 FLOAT INIT(-1.5);
DCL XN1 FLOAT INIT(+2.75);

MODEND;
