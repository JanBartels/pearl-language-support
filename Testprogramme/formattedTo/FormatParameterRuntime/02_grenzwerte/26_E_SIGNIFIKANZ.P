MODULE R26B;
SYSTEM;
    Konsole: /TY ->;
PROBLEM;
    SPC Konsole DATION OUT ALPHIC;

    Test: TASK MAIN;
        DCL Fehler FIXED(15);
        DCL Puffer CHAR(80);
        DCL Wert FLOAT;

        PUT '26_E_SIGNIFIKANZ' TO Konsole BY A,SKIP;
        Fehler = -999;
        Puffer = 'UNVERAENDERT';
        Wert = 12.5;
        CONVERT Wert TO Puffer BY RST(Fehler),E(23,16,30);
        PUT 'OUT=[',Puffer,'] RST=',Fehler TO Konsole BY A,A(32),A,F(7),SKIP;
    END;
MODEND;
