MODULE ARIO02;
SYSTEM;
    Eingabe: /NIL <-;
    Ausgabe: /NIL ->;
PROBLEM;
    SPC Eingabe DATION IN ALPHIC;
    SPC Ausgabe DATION OUT ALPHIC;

    Test: TASK MAIN;
        DCL Feld(1:3) FIXED(15) INIT(11,22,33);
        DCL Matrix(2,3) FIXED(15);

        ! Laut RTOS-UH, Tabelle 5.2: Keine ARRAY-Slices.
        PUT Feld(2:3) TO Ausgabe BY (2)F(5),SKIP;
        GET Feld(2:3) FROM Eingabe BY (2)F(5);
        PUT Matrix(1,2:3) TO Ausgabe BY (2)F(5),SKIP;
        GET Matrix(1,2:3) FROM Eingabe BY (2)F(5);
    END;
MODEND;
