MODULE TKS03;
SYSTEM;
    Eingang:  BU(0240FFFC) <-;
    Ausgang: BU(0240FFF8) ->;
    Beide:   BU(0240FFF4) <->;
PROBLEM;
    SPC Eingang DATION IN BASIC;
    SPC Ausgang DATION OUT BASIC;
    SPC Beide DATION INOUT BASIC;

    Probe: TASK;
        DCL Wort BIT(16);

        ! Fraglich: CONTROL als BY-Option bei TAKE/SEND.
        TAKE Wort FROM Eingang BY CONTROL(1);
        SEND Wort TO Ausgang BY CONTROL(1);
    END;
MODEND;
