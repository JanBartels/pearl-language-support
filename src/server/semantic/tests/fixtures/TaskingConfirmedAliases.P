P=MPC603;
SC=2000;
MODULE TaskingAliases;
SYSTEM;
Alarm: EV(00000001);
PROBLEM;
SPC Alarm INTERRUPT;
DCL StablePriority INV FIXED INIT(25);
DCL Interval INV DURATION INIT(1 SEC);
Worker: TASK;
END;
Runner: TASK MAIN;
    ACTIVATE Worker PRIORITY StablePriority;
    ACTIVATE Worker PRIO StablePriority + 1;
    EVERY Interval ACTIVATE Worker;
    ALL 5 * 0.1 SEC ACTIVATE Worker;
    WHEN Alarm RESUME;
    CONTINUE Worker;
    AFTER 0 SEC RESUME;
END;
MODEND;
